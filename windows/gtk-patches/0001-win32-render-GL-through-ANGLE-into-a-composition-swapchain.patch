diff --git a/gdk/win32/gdkdisplay-win32.c b/gdk/win32/gdkdisplay-win32.c
index 869e041..7f3703d 100644
--- a/gdk/win32/gdkdisplay-win32.c
+++ b/gdk/win32/gdkdisplay-win32.c
@@ -1307,6 +1307,66 @@ gdk_win32_display_get_monitor_scale_factor (GdkWin32Display *display_win32,
 #define EGL_PLATFORM_ANGLE_ANGLE          0x3202
 #endif
 
+#ifdef HAVE_EGL
+#ifndef EGL_D3D11_DEVICE_ANGLE
+#define EGL_D3D11_DEVICE_ANGLE 0x33A1
+#endif
+#ifndef EGL_PLATFORM_DEVICE_EXT
+#define EGL_PLATFORM_DEVICE_EXT 0x313F
+#endif
+
+/* ANGLE on the display's D3D11 device, so its rendering, the swapchains and
+ * Direct Composition share one device. Only with Direct Composition, which
+ * the EGL contexts present through.
+ */
+static GdkGLContext *
+gdk_win32_display_init_angle (GdkDisplay  *display,
+                              GError     **error)
+{
+  GdkWin32Display *display_win32 = GDK_WIN32_DISPLAY (display);
+  EGLDeviceEXT (*create_device) (EGLint, void *, const EGLAttrib *);
+  ID3D11Device *d3d11_device;
+  EGLDeviceEXT device;
+
+  if (!gdk_win32_display_get_dcomp_device (display_win32) ||
+      !gdk_has_feature (GDK_FEATURE_EGL) ||
+      !gdk_has_feature (GDK_FEATURE_GLES_API) ||
+      !epoxy_has_egl () ||
+      !epoxy_has_egl_extension (NULL, "EGL_ANGLE_device_creation") ||
+      !epoxy_has_egl_extension (NULL, "EGL_EXT_platform_device"))
+    {
+      g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                           "ANGLE with Direct Composition is not available");
+      return NULL;
+    }
+
+  d3d11_device = gdk_win32_display_get_d3d11_device (display_win32);
+  create_device = (gpointer) eglGetProcAddress ("eglCreateDeviceANGLE");
+  if (d3d11_device == NULL || create_device == NULL)
+    {
+      g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                           "No D3D11 device for ANGLE");
+      return NULL;
+    }
+
+  device = create_device (EGL_D3D11_DEVICE_ANGLE, d3d11_device, NULL);
+  if (device == EGL_NO_DEVICE_EXT)
+    {
+      g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                   "ANGLE refused the D3D11 device: 0x%x", eglGetError ());
+      return NULL;
+    }
+
+  if (!gdk_display_init_egl (display, EGL_PLATFORM_DEVICE_EXT, device, FALSE, error))
+    return NULL;
+
+  return g_object_new (GDK_TYPE_WIN32_GL_CONTEXT_EGL,
+                       "display", display,
+                       "allowed-apis", GDK_GL_API_GLES,
+                       NULL);
+}
+#endif
+
 static GdkGLContext *
 gdk_win32_display_init_gl (GdkDisplay  *display,
                            GError     **error)
@@ -1317,8 +1377,18 @@ gdk_win32_display_init_gl (GdkDisplay  *display,
 #endif
   GdkGLContext *context;
 
+#ifdef HAVE_EGL
+  /* WGL renders into a child window that Direct Composition shows without
+   * alpha, so transparent pixels turn black. ANGLE presents through a
+   * composition swapchain that keeps it. */
+  context = gdk_win32_display_init_angle (display, error);
+  if (context)
+    return context;
+  g_clear_error (error);
+#endif
