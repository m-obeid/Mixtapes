# Build output. target-prof is the frame-pointer build used for profiling.
/target/
/target-prof/

# Captured InnerTube responses for the offline parser tests. They hold
# account data, so they are recorded locally and never committed.
/fixtures/

# Flatpak and packaging build output.
/build-dir/
/.flatpak-builder/
/.ccache/
*.gresource

# Session files and debug dumps from development. data/ holds a saved
# browser session, which is a credential.
/data/
/*.json
*.log

# Editors and leftovers from the Python app.
.vscode/
.venv/
__pycache__/

# Generated next to the Windows bridge sources.
*.manifest
